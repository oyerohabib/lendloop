# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex (filled by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
# HTTP actions base URL (usually *.convex.site)
CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site

# Shared HMAC secret for Convex ↔ n8n (generate a long random string)
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Also set these in the Convex dashboard (Settings → Environment Variables):
#   CLERK_JWT_ISSUER_DOMAIN=https://YOUR_INSTANCE.clerk.accounts.dev
#   ADMIN_CLERK_IDS=user_xxx,user_yyy
#   N8N_WEBHOOK_SECRET=<same as above>
#   N8N_REQUEST_WEBHOOK_URL=http://host.docker.internal:5678/webhook/lendloop-request
#     (or http://localhost:5678/... if Convex can reach your machine;
#      for cloud Convex use an ngrok/cloudflared tunnel to local n8n)

# docker-compose reads N8N_WEBHOOK_SECRET and CONVEX_SITE_URL from this file
